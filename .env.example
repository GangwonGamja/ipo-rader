# 이 파일을 .env 로 복사해 값을 채우세요. .env 는 절대 공유·커밋하지 마세요.
DOMAIN=ipo.example.com

# 접속 계정: 이름:해시:역할 을 ; 로 구분 (해시는 `python -m ipo_radar hash-password 이름`)
IPO_RADAR_USERS=

# Claude API (AI 요약). console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=
# IPO_RADAR_AI_MAX=20          # 한 번 수집에 새로 요약할 최대 기업 수(비용 상한)

# 데이터 연결 키
DART_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
YOUTUBE_API_KEY=
KRX_AUTH_KEY=

# 1 이면 예시 데이터도 함께 표시(운영에서는 0)
IPO_RADAR_WITH_SAMPLE=0
