# 이 파일을 .env 로 복사해 값을 채우세요. .env 는 절대 공유·커밋하지 마세요.
DOMAIN=ipo.example.com

# 접속 코드: 관리자 코드 → 관리자 모드(데이터 관리·지금 갱신), 이용자 코드 → 이용자 모드
IPO_RADAR_ADMIN_CODE=
IPO_RADAR_USER_CODE=

# AI 요약: Google Gemini API(기본, 무료 등급 있음). aistudio.google.com → Get API key
GEMINI_API_KEY=
# IPO_RADAR_AI_PROVIDER=gemini   # claude 로 바꾸면 ANTHROPIC_API_KEY 사용
# IPO_RADAR_AI_MODEL=auto        # 또는 모델 이름 직접 지정
# IPO_RADAR_AI_MAX=20          # 한 번 수집에 새로 요약할 최대 기업 수(비용 상한)

# 데이터 연결 키
DART_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
YOUTUBE_API_KEY=
KRX_AUTH_KEY=

# 1 이면 예시 데이터도 함께 표시(운영에서는 0)
IPO_RADAR_WITH_SAMPLE=0
